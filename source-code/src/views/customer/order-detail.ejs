<%- include('../partials/head', { title }) %>
<style>
.customer-wrap{min-height:100vh;background:#faf7f4;color:#302a27}.customer-header{display:flex;align-items:center;justify-content:space-between;padding:18px clamp(18px,4vw,56px);background:#fff;border-bottom:1px solid #eee4dc}.customer-brand{font:600 25px Georgia,serif;color:#3c302b;text-decoration:none}.customer-brand small{display:block;font:10px Arial,sans-serif;letter-spacing:2px;color:#9b7e70}.customer-nav{display:flex;gap:18px;align-items:center}.customer-nav a{color:#6c554a;text-decoration:none;font-size:14px}.customer-main{max-width:1000px;margin:auto;padding:36px 24px}.customer-main h1{font:600 36px Georgia,serif}.customer-panel{background:#fff;border:1px solid #eee4dc;border-radius:14px;padding:24px;margin:20px 0}.customer-table{width:100%;border-collapse:collapse}.customer-table th,.customer-table td{text-align:left;padding:14px 8px;border-bottom:1px solid #f0e7e0}.customer-table th{font-size:11px;color:#9b8678;text-transform:uppercase}.customer-total{display:flex;justify-content:flex-end;font-size:20px;font-weight:700;color:#9c5c4e;padding-top:20px}.customer-muted{color:#8b7c73}
</style>
<div class="customer-wrap"><header class="customer-header"><a class="customer-brand" href="/shop">Lumière <small>CUSTOMER BEAUTY SPACE</small></a><nav class="customer-nav"><a href="/shop">Sản phẩm</a><a href="/my-orders">Đơn hàng của tôi</a><form action="/logout" method="post"><button class="customer-logout">Đăng xuất</button></form></nav></header>
<main class="customer-main"><p class="eyebrow">ORDER DETAIL</p><h1><%= order.order_code %></h1><p class="customer-muted">Ngày tạo: <%= dateTime(order.created_at) %> · Trạng thái: <%= ({COMPLETED:'Hoàn tất',DRAFT:'Đang xử lý',CANCELLED:'Đã hủy',REFUNDED:'Đã hoàn tiền'})[order.status] || order.status %></p><section class="customer-panel"><h2>Sản phẩm trong đơn</h2><div style="overflow:auto"><table class="customer-table"><thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody><% items.forEach((item) => { %><tr><td><strong><%= item.product_name %></strong><br><small class="customer-muted"><%= item.product_sku %></small></td><td><%= item.quantity %></td><td><%= money(item.unit_price) %></td><td><%= money(item.line_total) %></td></tr><% }) %></tbody></table></div><div class="customer-total">Tổng cộng: <span style="margin-left:12px"><%= money(order.total_amount) %></span></div></section><a class="button button-secondary" href="/my-orders">← Quay lại đơn hàng</a></main></div></body></html>
