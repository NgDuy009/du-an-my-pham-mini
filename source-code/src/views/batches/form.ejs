<%- include('../partials/head',{title}) %>
<div class="app-shell">
<%- include('../partials/sidebar') %>
<main class="main-area">
<%- include('../partials/topbar') %>
<div class="page-content">
<%- include('../partials/flash') %>
<section class="page-heading">
<div>
<p class="eyebrow">INVENTORY CONTROL</p>
<h1>Nhập lô hàng</h1>
<p class="muted">Mỗi lần nhập tạo một lô riêng để theo dõi hạn sử dụng.</p>
</div>
<a class="button button-secondary" href="/batches">
<i class="bi bi-arrow-left">
</i> Quay lại</a>
</section>
<div class="form-layout">
<section class="panel form-panel">
<form method="post" action="/batches" class="form-stack">
<div class="field-grid">
<div class="field field-full">
<label for="product_id">Sản phẩm <span class="required-mark">*</span>
</label>
<select name="product_id" id="product_id" required>
<option value="">-- Chọn sản phẩm --</option>
<% products.forEach((p) => { %>
<option value="<%= p.id %>">
<%= p.sku %> · <%= p.name %>
</option>
<% }) %>
</select>
</div>
<div class="field">
<label for="batch_code">Mã lô <span class="required-mark">*</span>
</label>
<input id="batch_code" name="batch_code" maxlength="80" required placeholder="VD: LOT-2026-001">
</div>
<div class="field">
<label for="supplier_id">Nhà cung cấp</label>
<select name="supplier_id" id="supplier_id">
<option value="">-- Không chọn --</option>
<% suppliers.forEach((s) => { %>
<option value="<%= s.id %>">
<%= s.name %>
</option>
<% }) %>
</select>
</div>
<div class="field">
<label for="manufactured_on">Ngày sản xuất</label>
<input type="date" id="manufactured_on" name="manufactured_on">
</div>
<div class="field">
<label for="expires_on">Hạn sử dụng</label>
<input type="date" id="expires_on" name="expires_on">
</div>
<div class="field">
<label for="received_on">Ngày nhập</label>
<input type="date" id="received_on" name="received_on">
</div>
<div class="field">
<label for="quantity_received">Số lượng nhập <span class="required-mark">*</span>
</label>
<input type="number" min="1" max="1000000" id="quantity_received" name="quantity_received" required value="1">
</div>
<div class="field">
<label for="unit_cost">Giá nhập mỗi đơn vị (₫) <span class="required-mark">*</span>
</label>
<input type="number" min="0" step="1000" id="unit_cost" name="unit_cost" required value="0">
</div>
<div class="field field-full">
<label for="note">Ghi chú</label>
<textarea name="note" id="note" rows="3">
</textarea>
</div>
</div>
<div class="form-actions">
<a class="button button-secondary" href="/batches">Hủy</a>
<button class="button button-primary">
<i class="bi bi-box-arrow-in-down">
</i> Xác nhận nhập kho</button>
</div>
</form>
</section>
<aside class="form-aside">
<div class="aside-card">
<span class="aside-icon">
<i class="bi bi-calendar2-check">
</i>
</span>
<h3>Quản lý hạn dùng</h3>
<p>Nhập ngày hết hạn để hệ thống đưa lô hàng vào danh sách cần chú ý trong báo cáo.</p>
<div class="aside-divider">
</div>
<p>
<i class="bi bi-arrow-repeat">
</i> Số lượng tồn được cập nhật bằng giao dịch SQL.</p>
</div>
</aside>
</div>
<%- include('../partials/footer') %>
</div>
</main>
</div>
<script src="/js/app.js" defer>
</script>
</body>
</html>
