<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hóa đơn <%= order.order_code %>
</title>
<link href="/css/app.css" rel="stylesheet">
</head>
<body class="receipt-page">
<main class="receipt-paper">
<div class="receipt-brand">
<span class="brand-mark">
<i class="bi bi-flower1">
</i>
</span>
<h1>Lumière Cosmetic</h1>
<p>HÓA ĐƠN BÁN HÀNG</p>
</div>
<div class="receipt-meta">
<span>Mã hóa đơn</span>
<strong>
<%= order.order_code %>
</strong>
<span>Ngày tạo</span>
<strong>
<%= dateTime(order.created_at) %>
</strong>
<span>Khách hàng</span>
<strong>
<%= order.customer_name || 'Khách lẻ' %>
</strong>
</div>
<table class="receipt-table">
<thead>
<tr>
<th>Sản phẩm</th>
<th>SL</th>
<th>Đơn giá</th>
<th>Thành tiền</th>
</tr>
</thead>
<tbody>
<% items.forEach((item) => { %>
<tr>
<td>
<%= item.product_name %>
</td>
<td>
<%= item.quantity %>
</td>
<td>
<%= money(item.unit_price) %>
</td>
<td>
<%= money(item.line_total) %>
</td>
</tr>
<% }) %>
</tbody>
</table>
<div class="receipt-total">
<p>
<span>Tạm tính</span>
<strong>
<%= money(order.subtotal) %>
</strong>
</p>
<p>
<span>Giảm giá</span>
<strong>
<%= money(order.discount_amount) %>
</strong>
</p>
<p class="grand-total">
<span>Tổng thanh toán</span>
<strong>
<%= money(order.total_amount) %>
</strong>
</p>
</div>
<p class="receipt-thanks">Cảm ơn quý khách đã mua hàng!<br>Chúc bạn luôn rạng rỡ.</p>
<button class="button button-primary no-print" onclick="window.print()">In hóa đơn</button>
</main>
</body>
</html>
