<%- include('../partials/head', { title }) %>
<style>
.customer-wrap{min-height:100vh;background:#faf7f4;color:#302a27}.customer-header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px clamp(18px,4vw,56px);background:#fff;border-bottom:1px solid #eee4dc}.customer-brand{font:600 25px Georgia,serif;color:#3c302b;text-decoration:none}.customer-brand small{display:block;font:10px Arial,sans-serif;letter-spacing:2px;color:#9b7e70}.customer-nav{display:flex;gap:18px;align-items:center}.customer-nav a{color:#6c554a;text-decoration:none;font-size:14px}.customer-logout{border:0;background:none;color:#8b6254;cursor:pointer}.customer-main{max-width:1180px;margin:auto;padding:36px 24px}.customer-main h1{font:600 38px Georgia,serif}.customer-muted{color:#8b7c73}.customer-table-wrap{overflow:auto;background:#fff;border:1px solid #eee4dc;border-radius:14px}.customer-table{width:100%;border-collapse:collapse;min-width:650px}.customer-table th,.customer-table td{text-align:left;padding:16px;border-bottom:1px solid #f0e7e0;font-size:14px}.customer-table th{font-size:11px;letter-spacing:1px;color:#9b8678;text-transform:uppercase}.customer-table a{color:#9c5c4e;font-weight:600;text-decoration:none}.customer-empty{padding:50px;text-align:center;background:#fff;border:1px dashed #e4d5c9;border-radius:16px}.customer-status{padding:5px 9px;border-radius:20px;background:#edf6ee;color:#47734d;font-size:12px}.customer-logout-form{display:inline}
</style>
<div class="customer-wrap"><header class="customer-header"><a class="customer-brand" href="/shop">Lumière <small>CUSTOMER BEAUTY SPACE</small></a><nav class="customer-nav"><a href="/shop">Sản phẩm</a><a href="/my-orders">Đơn hàng của tôi</a><form class="customer-logout-form" action="/logout" method="post"><button class="customer-logout">Đăng xuất</button></form></nav></header>
<main class="customer-main"><p class="eyebrow">ORDER HISTORY</p><h1>Đơn hàng của tôi</h1><p class="customer-muted">Chỉ hiển thị đơn hàng gắn với tài khoản của bạn.</p>
<% if (!orders.length) { %><div class="customer-empty"><h2>Bạn chưa có đơn hàng</h2><p class="customer-muted">Đơn hàng được cửa hàng ghi nhận sẽ xuất hiện tại đây.</p><a class="button button-primary" href="/shop">Xem sản phẩm</a></div><% } else { %><div class="customer-table-wrap"><table class="customer-table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Số sản phẩm</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody><% orders.forEach((order) => { %><tr><td><strong><%= order.order_code %></strong></td><td><%= dateTime(order.created_at) %></td><td><%= order.item_count %></td><td><strong><%= money(order.total_amount) %></strong></td><td><span class="customer-status"><%= ({COMPLETED:'Hoàn tất',DRAFT:'Đang xử lý',CANCELLED:'Đã hủy',REFUNDED:'Đã hoàn tiền'})[order.status] || order.status %></span></td><td><a href="/my-orders/<%= order.id %>">Chi tiết →</a></td></tr><% }) %></tbody></table></div><% } %>
</main></div></body></html>
